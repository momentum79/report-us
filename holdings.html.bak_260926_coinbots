                                <td style="font-weight:bold; color:#2c3e50; cursor:pointer; text-decoration:underline dotted;" data-v4-code="${s.ticker}" data-v4-market="US">${s.ticker}</td>
                                <td style="white-space:nowrap;" data-sv="${s.stock_name || ''}">${(s.stock_name || '').substring(0, 8)}</td>
                                <td style="text-align:right; white-space:nowrap;" data-sv="${s.quantity || 0}">${fmt(s.quantity)}</td>
                                <td style="text-align:right; white-space:nowrap;" data-sv="${s.current_price || 0}">$${(s.current_price || 0).toFixed(2)}</td>
                                <td style="text-align:right; white-space:nowrap;" data-sv="${s.avg_price || 0}">$${(s.avg_price || 0).toFixed(2)}</td>
                                <td style="text-align:center; color:#000; font-size:0.82rem; white-space:nowrap;" data-sv="${s.buy_date || ''}">${(s.buy_date || '').slice(-5)}</td>
                                <td class="${rCls}" style="text-align:right; white-space:nowrap;" data-sv="${rate}">${sign}${rate.toFixed(2)}%</td>
                                <td style="text-align:right; white-space:nowrap;" data-sv="${s.eval_amount || 0}">${fmt(Math.round((s.eval_amount || 0) / 10000))}만</td>
                                <td style="text-align:center; font-size:0.82rem; white-space:nowrap;" data-sv="${dpUs == null ? '' : dpUs}">${dpUs == null ? '' : 'D+' + dpUs}</td>
                                <td style="text-align:center;" data-sv="${candle}">${candleHtml}</td>
                                <td style="text-align:center;" data-sv="${tag}">${tagHtml}</td>
                            </tr>
                        `;
                    });
                }
                html += `</tbody></table>`;
                html += `</div>`;   // ← 미국 컬럼 끝
                html += `</div>`;   // ← ga-right 끝
            }

            // [4] 투자비중 도넛 — 한+미 계좌는 위(한국요약 옆)에서 이미 그렸다
            if (!hasUS) html += renderInvestDonut(summ, usSumm, hasUS);

            html += `</div>`;   // ← acct-flex 끝

            // [4] 상세 분석 -- 한국 전용 계좌만 여기(전체 폭)에 표시
            if (!hasUS) html += `<div id="anal-area"></div>`;

            area.innerHTML = html;

            // 보유종목 테이블 제목 클릭 정렬 (한국/미국 각각 독립)
            ['tbl-kr', 'tbl-us'].forEach(id => makeSortable(document.getElementById(id)));

            // 동적으로 삽입된 미국 티커 셀에 V4 차트 호버 트리거 재바인딩
            if (window.v4RebindTriggers) window.v4RebindTriggers();

            loadAnal(acc, analysisData);
        }

        async function loadAnal(acc, initialData) {
            const area = document.getElementById('anal-area');
            if (!area) return;

            // 이미 데이터를 가지고 있는 경우 즉시 렌더링
            if (initialData && initialData.data) {
                renderAnalTable(initialData.data);
                return;
            }

            try {
                const isLocal = location.protocol === 'file:';
                const url = isLocal ? `holdings_analysis_${acc}.json` : `holdings_analysis_${acc}.json?v=${Date.now()}`;
                const res = await fetch(url);
                if (!res.ok) {
                    if (acc === '1887') {
                        const resOld = await fetch(`holdings_analysis.json`);
                        if (!resOld.ok) return;
                        const dataOld = await resOld.json();
                        renderAnalTable(dataOld.data || []);
                    }
                    return;
                }
                const data = await res.json();
                renderAnalTable(data.data || []);
            } catch (err) {
                console.log('Analysis error', err);
            }
        }

        function renderAnalTable(items) {
            const area = document.getElementById('anal-area');
            if (!area) return;
            if (items.length === 0) return;

            // 정렬을 위해 데이터 보관
            window.lastAnalItems = items;

            // 꽉 찬 기술적 분석 테이블 (가로스크롤, 콤팩트 스타일)
            let h = `
                <div class="analysis-box">
                    <h3 style="margin:0 0 10px 0; font-size:1.1rem; cursor:pointer; color:#2c3e50; display:inline-block;" onclick="toggleAnalSort()">🔍 기술적 분석 (상세)</h3>
                    <div style="overflow-x:auto;">
                        <table class="anal-table">
                            <thead>
                                <tr>
                                    <th>티커</th>
                                    <th>종목명</th>
                                    <th>위치</th>
                                    <th>Sco</th>
                                    <th>정</th>
                                    <th>5</th><th>10</th><th>20</th><th>60</th><th>120</th>
                                    <th>추세</th>
                                    <th>136평</th>
                                </tr>
                            </thead>
                            <tbody>
            `;

            items.forEach(r => {
                const ticker = r.Ticker;

                // ETF 브랜드 접두어 제거, 6글자로 표시
                let name = getShortName(r.ETF || r.Name || '');

                const sco = (r.sco !== null) ? parseFloat(r.sco).toFixed(1) : '-';
                const pos = (r['위치'] !== null) ? parseInt(r['위치']) : '-';
                const jung = r['정'] || '-';

                // 이평선 상/하 (색상 적용)
                const m0 = r['5'] === '상' ? '<span class="up-cw">상</span>' : (r['5'] === '하' ? '<span class="dn-cw">하</span>' : '-');
                const m1 = r['10'] === '상' ? '<span class="up-cw">상</span>' : (r['10'] === '하' ? '<span class="dn-cw">하</span>' : '-');
                const m2 = r['20'] === '상' ? '<span class="up-cw">상</span>' : (r['20'] === '하' ? '<span class="dn-cw">하</span>' : '-');
                const m3 = r['60'] === '상' ? '<span class="up-cw">상</span>' : (r['60'] === '하' ? '<span class="dn-cw">하</span>' : '-');
                const m4 = r['120'] === '상' ? '<span class="up-cw">상</span>' : (r['120'] === '하' ? '<span class="dn-cw">하</span>' : '-');

                const trend = (r['추세'] || '-');
                const tInlineStyle = getTrendStyle(trend) + ' padding:1px 3px; border-radius:3px; font-size:11px;';

                const avg_ret = r['1/3/6 평균'] ? parseFloat(r['1/3/6 평균']).toFixed(1) + '%' : '-';

                // Intensity check (티커 뒤에 **)
                const displayTicker = r.Intensity ? `${ticker}**` : ticker;

                h += `
                    <tr>
                        <td style="font-weight:bold; color:#333;">${displayTicker}</td>
                        <td style="text-align:left;">${name}</td>
                        <td>${pos}</td>
                        <td>${sco}</td>
                        <td style="font-size:11px;">${jung}</td>
                        <td>${m0}</td>
                        <td>${m1}</td>
                        <td>${m2}</td>
                        <td>${m3}</td>
                        <td>${m4}</td>
                        <td><span style="${tInlineStyle}">${trend}</span></td>
                        <td>${avg_ret}</td>
                    </tr>
                `;
            });
            h += `</tbody></table></div></div>`;
            area.innerHTML = h;
        }

        function toggleAnalSort() {
            if (!window.lastAnalItems || window.lastAnalItems.length === 0) return;
            
            // 위치(pos) 기준으로 토글 정렬
            const state = window.analSortState || { key: '위치', asc: true };
            state.asc = !state.asc;
            window.analSortState = state;

            window.lastAnalItems.sort((a, b) => {
                const valA = a['위치'] === null ? 999 : parseInt(a['위치']);
                const valB = b['위치'] === null ? 999 : parseInt(b['위치']);
                return state.asc ? valA - valB : valB - valA;
            });

            renderAnalTable(window.lastAnalItems);
        }

        // 초기 실행
        document.addEventListener('DOMContentLoaded', () => {
            loadWeekly();
        });
    </script>


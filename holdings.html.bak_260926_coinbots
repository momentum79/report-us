        // 투자비중 도넛 (KR/US/현금 3분할). 색상 고정: KR=#4a7ac7, US=#e74c3c, 현금=#bdc3c7
        const INVEST_DONUT_COLORS = { kr: '#4a7ac7', us: '#e74c3c', jp: '#f1c40f', cash: '#bdc3c7' };
        // 통화비중 도넛. 원화=파랑/달러=빨강 은 위 투자비중과 같은 뜻이 되도록 맞춤.
        const CURRENCY_DONUT_COLORS = { KR: '#4a7ac7', US: '#e74c3c', JP: '#f1c40f', ETC: '#27ae60' };
        // 링 바깥 글자용. 노랑은 흰 배경에서 안 보여 어둡게 낮춘다.
        const CURRENCY_LABEL_COLORS = { KR: '#4a7ac7', US: '#e74c3c', JP: '#b7930b', ETC: '#27ae60' };

        // 도넛 링 지오메트리 — 가운데 홀 지름이 도넛 지름의 35% (= r±sw/2 → 바깥 49, 안쪽 17.15)
        const DONUT_R = 33.075, DONUT_SW = 31.85, DONUT_CX = 50, DONUT_CY = 50;
        const DONUT_C = 2 * Math.PI * DONUT_R;
        const DONUT_MIN_INSIDE_PCT = 7;   // 이보다 얇은 조각은 글자가 안 들어가 바깥에 표기

        // 자산 분해. 투자비중·통화비중 두 도넛이 이 하나를 같이 쓴다 → 분모(total)가 반드시 일치한다.
        //   투자비중 = krInvest / usInvest / jpInvest / cash
        //   통화비중 = (krInvest+krCash) / (usInvest+usCash) / jpNet / etcNet
        // 어느 쪽으로 묶어도 합은 total 이다.
        //
        // KR: 국내주식 평가 + 원화 예수금.
        //   원화예수금은 kt00001.entr(D+0)가 아니라 kt00003 추정예탁자산에서 역산한다.
        //   추정예탁자산은 D+2 정산 반영이라 '오늘 판 주식'이 평가액에서 빠진 뒤 현금으로
        //   들어오기 전 2일 공백을 이미 메워준다(= 매도대금 미수금 포함).
        // US: 미국주식(ust21070 합) + 달러예수금(ust21120 USD 줄).
        // JP: ust21120 의 USD 외 통화 줄. 통합증거금으로 매수하면 그 통화 예수금이 음수가 되므로
        //   예수금과 주식평가를 같이 봐야 순포지션이 된다.
        //   ※ 일본 보유는 ust21070(해외잔고)에 안 나오고 ust21120 JPY 줄에만 존재한다.
        //   ※ jpInvest 는 'USD 외 통화 주식평가' 전체다. 현재 실보유는 일본뿐이라 JP 로 표기한다.
        function computeAssetParts(summ, usSumm, hasUS) {
            summ = summ || {};
            const krInvest = summ.tot_evlt_amt || 0;
            const krTotal = summ.total_asset || 0;
            const krCash = krTotal > 0 ? Math.max(krTotal - krInvest, 0) : (summ.cash || 0);
            const us = (hasUS && usSumm) ? usSumm : null;
            const usInvest = us ? (us.us_stock_krw || 0) : 0;
            const usCash = us ? (us.usd_cash_krw || 0) : 0;
            const fxNet = us ? (us.fx_other_krw || 0) : 0;          // USD 외 통화 순자산
            const jpInvest = us ? (us.fx_other_stock_krw || 0) : 0; // 그중 주식평가
            const fxCash = fxNet - jpInvest;                        // 그중 예수금(음수 가능)
            // 통화비중용 JPY / 그 외 분리
            const fx = (us && us.fx) ? us.fx : {};
            const jpyRow = fx.JPY || {};
            const jpNet = (jpyRow.cash_krw || 0) + (jpyRow.stock_krw || 0);
            return {
                krInvest, usInvest, jpInvest,
                krCash, usCash, fxCash,
                cash: krCash + usCash + fxCash,
                jpNet, etcNet: fxNet - jpNet,
                total: krInvest + usInvest + krCash + usCash + fxNet,
            };
        }

        // 통화비중 4버킷. computeAssetParts 결과를 다시 묶기만 하므로 총액이 투자비중과 같다.
        // 순마이너스 통화는 조각을 그릴 수 없어 0 으로 눕힌다(그만큼 합이 total 보다 작아질 수 있음).
        function currencyBuckets(p) {
            return {
                KR: Math.max(p.krInvest + p.krCash, 0),
                US: Math.max(p.usInvest + p.usCash, 0),
                JP: Math.max(p.jpNet, 0),
                ETC: Math.max(p.etcNet, 0),
                total: p.total,
            };
        }

        // 도넛 조각 하나. len/offset 은 원둘레 단위.
        function donutSeg(len, offset, color) {
            return `<circle cx="${DONUT_CX}" cy="${DONUT_CY}" r="${DONUT_R}" fill="transparent" stroke="${color}" ` +
                `stroke-width="${DONUT_SW}" stroke-dasharray="${len} ${DONUT_C - len}" stroke-dashoffset="${-offset}"></circle>`;
        }

        // 조각 중앙 좌표. svg 를 통째로 -90도 돌리는 대신 각도에서 -90 을 빼서 글자는 똑바로 세운다.
        function donutMidPoint(midPct, radius) {
            const a = (midPct / 100) * 2 * Math.PI - Math.PI / 2;
            return { x: DONUT_CX + radius * Math.cos(a), y: DONUT_CY + radius * Math.sin(a) };
        }

        // 조각 안 2줄 라벨(이름 / 정수%). 두 도넛이 같은 서식을 쓰도록 한 군데로 모음.
        function donutSliceLabel(midPct, label, pct) {
            const p = donutMidPoint(midPct, DONUT_R);
            return `<text class="idn-slice-lbl" x="${p.x.toFixed(2)}" y="${(p.y - 4.5).toFixed(2)}">${label}</text>`
                + `<text class="idn-slice-lbl" x="${p.x.toFixed(2)}" y="${(p.y + 4.5).toFixed(2)}">${Math.round(pct)}%</text>`;
        }

        // 통화비중 도넛: 가운데 홀은 비우고, 색칠된 조각 안에 'US / 38%' 2줄 표기.
        // 조각이 너무 얇으면(9% 미만) 글자가 안 들어가므로 링 바깥에 조각 색으로 표기.
        function renderCurrencyDonut(c) {
            if (!c || !c.total || c.total <= 0) return '';
            const order = [['KR', 'KR'], ['US', 'US'], ['JP', 'JP'], ['ETC', 'ETC']];
            let acc = 0, segs = '', labels = '', outside = '';
            order.forEach(([key, label]) => {
                const pct = (c[key] / c.total) * 100;
                if (pct <= 0) return;
                const color = CURRENCY_DONUT_COLORS[key];
                segs += donutSeg((pct / 100) * DONUT_C, (acc / 100) * DONUT_C, color);
                const mid = acc + pct / 2;
                if (pct >= DONUT_MIN_INSIDE_PCT) {
                    labels += donutSliceLabel(mid, label, pct);
                } else {
                    // 조각이 얇아 글자가 못 들어가는 통화. svg 밖(HTML 오버레이)에 조각 색으로 표기.
                    const p = donutMidPoint(mid, 55);
                    outside += `<span class="idn-out-lbl" style="left:${p.x.toFixed(2)}%; top:${p.y.toFixed(2)}%; color:${CURRENCY_LABEL_COLORS[key]};">`
                        + `${label} ${Math.round(pct)}%</span>`;
                }
                acc += pct;
            });
            return `
                <div class="invest-donut-unit">
                    <div class="invest-donut-title">💱 통화비중</div>
                    <div class="invest-donut-wrap">
                        <svg class="idn-plain" viewBox="0 0 100 100">
                            <g transform="rotate(-90 ${DONUT_CX} ${DONUT_CY})">
                                <circle cx="${DONUT_CX}" cy="${DONUT_CY}" r="${DONUT_R}" fill="transparent" stroke="#f1f1f1" stroke-width="${DONUT_SW}"></circle>
                                ${segs}
                            </g>
                            ${labels}
                        </svg>
                        ${outside}
                    </div>
                </div>
            `;
        }

        function renderDonutCard(p, opts = {}) {
            if (!p || !p.total || p.total <= 0) return '';
            const totalAll = p.total;
            const krInvest = p.krInvest;
            const usInvestKrw = p.usInvest;
            const jpInvestKrw = p.jpInvest || 0;
            const hasUS = opts.showUS !== false;
            const hasJP = hasUS && jpInvestKrw > 0;

            let krPct = (krInvest / totalAll) * 100;
            let usPct = (usInvestKrw / totalAll) * 100;
            let jpPct = hasJP ? (jpInvestKrw / totalAll) * 100 : 0;
            let cashPct = Math.max(100 - krPct - usPct - jpPct, 0);
            const investedPct = Math.min(krPct + usPct + jpPct, 100);

            // 조각 안 이름표 + 정수 % (소수점은 아래 범례에만).
            // 통화비중 도넛과 같은 viewBox·같은 링 지오메트리라 두 도넛 크기가 정확히 같다.
            const parts = [
                [krPct, INVEST_DONUT_COLORS.kr, 'KR'],
                ...(hasUS ? [[usPct, INVEST_DONUT_COLORS.us, 'US']] : []),
                ...(hasJP ? [[jpPct, INVEST_DONUT_COLORS.jp, 'JP']] : []),
                [cashPct, INVEST_DONUT_COLORS.cash, '현금'],
            ];
            let acc = 0, segs = '', labels = '';
            parts.forEach(([pct, color, label]) => {
                if (pct <= 0) return;
                segs += donutSeg((pct / 100) * DONUT_C, (acc / 100) * DONUT_C, color);
                if (pct >= DONUT_MIN_INSIDE_PCT) {
                    labels += donutSliceLabel(acc + pct / 2, label, pct);
                }
                acc += pct;
            });

            const svg = `
                <svg class="idn-plain" viewBox="0 0 100 100">
                    <g transform="rotate(-90 ${DONUT_CX} ${DONUT_CY})">
                        <circle cx="${DONUT_CX}" cy="${DONUT_CY}" r="${DONUT_R}" fill="transparent" stroke="#f1f1f1" stroke-width="${DONUT_SW}"></circle>
                        ${segs}
                    </g>
                    ${labels}
                </svg>
            `;

            const legendRow = (color, name, pct, amt) => `
                <div class="idl-row">
                    <span class="idl-name"><span class="idl-dot" style="background:${color}"></span>${name}</span>
                    <span class="idl-val">${pct.toFixed(1)}%</span>
                    <span class="idl-amt">${fmt(Math.round(amt / 10000))}만</span>
                </div>
            `;
            // 총자산 = 위 조각들의 합. dot 은 자리만 맞추고 색은 없앤다(조각이 아니므로).
            const totalRow = `
                <div class="idl-row idl-total">
                    <span class="idl-name"><span class="idl-dot" style="background:transparent"></span>총자산</span>
                    <span class="idl-val"></span>
                    <span class="idl-amt">${fmt(Math.round(totalAll / 10000))}만</span>
                </div>
            `;

            return `
                <div class="invest-donut-card">
                    <div class="invest-donut-top">
                        <div class="invest-donut-unit">
                            <div class="invest-donut-title">💹 투자비중</div>
                            <div class="invest-donut-wrap">
                                ${svg}
                                <div class="invest-donut-center">
                                    <div class="idc-num">${investedPct.toFixed(0)}%</div>
                                </div>
                            </div>
                        </div>
                        ${renderCurrencyDonut(opts.currency)}
                    </div>
                    <div class="invest-donut-legend">
                        ${legendRow(INVEST_DONUT_COLORS.kr, 'KR 투자', krPct, krInvest)}
                        ${hasUS ? legendRow(INVEST_DONUT_COLORS.us, 'US 투자', usPct, usInvestKrw) : ''}
                        ${hasJP ? legendRow(INVEST_DONUT_COLORS.jp, 'JP 투자', jpPct, jpInvestKrw) : ''}
                        ${legendRow(INVEST_DONUT_COLORS.cash, '현금', cashPct, p.cash)}
                        ${totalRow}
                    </div>
                </div>
            `;
        }

        function renderInvestDonut(summ, usSumm, hasUS) {
            const parts = computeAssetParts(summ, usSumm, hasUS);
            const card = renderDonutCard(parts, {
                showUS: hasUS,
                currency: currencyBuckets(parts),
            });
            if (!card) return '';
            return `
                <div class="invest-donut-outer">
                    ${hasUS ? '<div class="col-cap" style="visibility:hidden;">-</div>' : ''}
                    ${card}
                </div>
            `;
        }

        function getTrendStyle(trend) {
            if (trend === 'LIME') return 'background-color:#2ecc71; color:#000; font-weight:bold;';
            if (trend === 'GREEN') return 'background-color:#27ae60; color:#000; font-weight:bold;';
            if (trend === 'RED') return 'background-color:#e74c3c; color:#fff; font-weight:bold;';
            if (trend === 'PURPLE') return 'background-color:#9b59b6; color:#fff; font-weight:bold;';
            return '';
        }

        function render(data, acc, trendMap, analysisData) {
            const area = document.getElementById('main-area');
            const stocks = data.holdings || [];
            const summ = data.summary || {};
            const usStocks = data.us_holdings || [];
            const usSumm = data.us_summary || null;

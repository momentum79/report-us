                `;
                if (usStocks.length === 0) {
                    html += `<tr><td colspan="11" style="text-align:center; padding:30px;">미국 보유 종목이 없습니다.</td></tr>`;
                } else {
                    usStocks.forEach(s => {
                        const rate = parseFloat(s.profit_rate || 0);
                        const isDanger = rate < -6;
                        let rCls = 'pos';
                        if (rate < 0 && rate >= -4) rCls = 'mid';
                        else if (rate < -4) rCls = 'neg';
                        const sign = rate >= 0 ? '+' : '';
                        const candle = s.candle || '';
                        const tag = s.tag || '';
                        const candleHtml = candle
                            ? `<span style="background:#eef2f7;color:#4a5568;font-size:0.68rem;padding:1px 5px;border-radius:3px;white-space:nowrap;">${candle}</span>`
                            : '';
                        const tagHtml = tag
                            ? `<span style="background:#fdf2e9;color:#a04000;font-size:0.68rem;padding:1px 5px;border-radius:3px;white-space:nowrap;">${tag}</span>`
                            : '';
                        const dpUs = dPlusDays(s.buy_date);
                        html += `

        /* 보유종목 테이블: 제목 클릭 정렬 (화살표 없이 커서로만 표시) */
        table.sortable th {
            cursor: pointer;
            -webkit-user-select: none;
            user-select: none;
        }

        table.sortable th:hover {
            filter: brightness(1.12);
        }

        td {
            padding: 8px 8px;

  cs.setData(rows.map(b=>({time:b[0],open:b[1],high:b[2],low:b[3],close:b[4]})));
  if(kospiLine){
    const m=rows.length,aIdx=Math.max(0,m-1-20),K0=KOSPI_D[rows[aIdx][0]],P0=rows[aIdx][4];

            const showKrMeta = ['1887', '8042', '2773'].includes(String(acc));

            let html = `<div class="update-time">최종 업데이트: ${data.updated || '-'}</div>`;
            html += `<div class="acct-flex${hasUS ? ' has-us' : ''}">`;
            html += hasUS ? `<div class="ga-left"><div class="ga-lefttop"><div class="ga-krsum"><div class="col-cap">🇰🇷 한국</div>` : `<div class="acct-col">`;

            // [1] 한국 요약 카드 (테이블 위)
            const krRealized = summ.tdy_realized_pl;
            html += `
                <div class="summary-card">
                    <h3 style="margin: 0 0 15px 0; font-size:1.1rem;">💰 한국 요약 (${acc})</h3>
                    <div class="summary-row">
                        <span class="label">총자산</span>
                        <span class="val">${fmt(summ.total_asset)}원</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">평가총액</span>
                        <span class="val">${fmt(summ.tot_evlt_amt)}원</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">평가손익</span>
                        <span class="val ${summ.tot_evlt_pl >= 0 ? 'pos' : (summ.tot_evlt_pl >= -1000000 && summ.tot_evlt_pl < 0 ? 'mid' : 'neg')}">${summ.tot_evlt_pl >= 0 ? '+' : ''}${fmt(summ.tot_evlt_pl)}원</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">수익률</span>
                        <span class="val ${summ.tot_prft_rt >= 0 ? 'pos' : (summ.tot_prft_rt >= -4 ? 'mid' : 'neg')}">${summ.tot_prft_rt >= 0 ? '+' : ''}${(summ.tot_prft_rt || 0).toFixed(2)}%</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">당일 실현손익</span>
                        <span class="val ${krRealized == null ? '' : (krRealized >= 0 ? 'pos' : 'neg')}">${krRealized == null ? '-' : (krRealized >= 0 ? '+' : '') + fmt(krRealized) + '원'}</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">예수금</span>
                        <span class="val">${summ.cash == null ? '-' : fmt(summ.cash) + '원'}</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">주식비중</span>
                        <span class="val" style="color:#2c3e50">${(summ.stock_ratio || 0).toFixed(2)}%</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">보유종목수</span>
                        <span class="val" style="color:#2c3e50">${fmt(stocks.length)}개</span>
                    </div>
                </div>
            `;

            if (hasUS) {
                html += `</div>`;                                   // ← ga-krsum 끝
                html += renderInvestDonut(summ, usSumm, hasUS);     // 도넛(한국요약 오른쪽)
                html += `</div>`;                                   // ← ga-lefttop 끝
                html += `<div class="ga-krtab">`;
            }

            // [2] 한국 보유 종목 테이블
            html += `
                <table id="tbl-kr">
                    <thead>
                        <tr>
                            <th>종목명</th>
                            <th style="text-align:right;">주수</th>
                            <th style="text-align:center;">위치</th>
                            <th style="text-align:center;">체결강도</th>
                            <th style="text-align:right;">수익률</th>
                            <th style="text-align:right;">평가금액</th>
                            <th style="text-align:center;">D+n</th>
                            <th style="text-align:center;">NXT</th>
                            ${showKrMeta ? '<th style="text-align:center;">봉</th><th style="text-align:center;">Tag</th>' : ''}
                        </tr>
                    </thead>
                    <tbody>
            `;

            if (stocks.length === 0) {
                html += `<tr><td colspan="${showKrMeta ? 10 : 8}" style="text-align:center; padding:30px;">보유 종목 데이터가 없습니다.</td></tr>`;
            } else {
                stocks.forEach(s => {
                    const rate = parseFloat(s.profit_rate || 0);
                    const isDanger = rate < -6;

                    let rCls = 'pos';
                    if (rate < 0 && rate >= -4) rCls = 'mid';
                    else if (rate < -4) rCls = 'neg';

                    const sign = rate >= 0 ? '+' : '';
                    
                    // 추세 스타일 및 위치 정보 적용
                    const trendInfo = trendMap[s.stock_code] || { trend: '-', pos: '-' };
                    const tStyle = getTrendStyle(trendInfo.trend);
                    
                    // 위치 배지 HTML 생성
                    const posVal = trendInfo.pos;
                    const posBadge = (posVal >= 1 && posVal <= 5) 
                        ? `<span class="pos-badge pos-${posVal}">${posVal}</span>` 
                        : (posVal || '-');

                    // ETF 브랜드 접두어 제거, 6글자로 표시
                    const rawName = s.stock_name || 'N/A';
                    const displayName = getShortName(rawName);
                    const candle = s.candle || '';
                    const tag = s.tag || '';
                    const candleHtml = candle
                        ? `<span style="background:#eef2f7;color:#4a5568;font-size:0.68rem;padding:1px 5px;border-radius:3px;white-space:nowrap;">${candle}</span>`
                        : '';
                    const tagHtml = tag
                        ? `<span style="background:#fff3e6;color:#b45309;font-size:0.68rem;padding:1px 5px;border-radius:3px;white-space:nowrap;">${tag}</span>`
                        : '';
                    const dpKr = dPlusDays(s.buy_date);

                    html += `
                        <tr class="${isDanger ? 'danger' : ''}">
                            <td style="${tStyle}" data-code="${s.stock_code}" data-name="${rawName}" data-sv="${rawName}">${displayName}</td>
                            <td style="text-align:right;" data-sv="${s.quantity || 0}">${fmt(s.quantity)}</td>
                            <td style="text-align:center; font-weight:bold; color:#2c3e50;" data-sv="${(posVal >= 1 && posVal <= 5) ? posVal : ''}">${posBadge}</td>
                            <td style="text-align:center;" data-sv="${(s.cntr_str === null || s.cntr_str === undefined || s.cntr_str === '' || isNaN(parseFloat(s.cntr_str))) ? '' : parseFloat(s.cntr_str)}">${(() => {
                                const cs = s.cntr_str;
                                if (cs === null || cs === undefined || cs === "") return '<span class="cs-neu">-</span>';
                                const v = parseFloat(cs);
                                if (isNaN(v)) return '<span class="cs-neu">-</span>';
                                if (v >= 100) return `<span style="color:#27ae60; font-weight:bold; font-size:0.82rem;">${v.toFixed(0)}</span>`;
                                return `<span style="color:#e74c3c; font-weight:bold; font-size:0.82rem;">${v.toFixed(0)}</span>`;
                            })()}</td>
                            <td class="${rCls}" style="text-align:right;" data-sv="${rate}">${sign}${rate.toFixed(2)}%</td>
                            <td style="text-align:right;" data-sv="${s.eval_amount || 0}">${fmt(Math.round((s.eval_amount || 0) / 10000))}만</td>
                            <td style="text-align:center; font-size:0.82rem; white-space:nowrap;" data-sv="${dpKr == null ? '' : dpKr}">${dpKr == null ? '' : 'D+' + dpKr}</td>
                            <td style="text-align:center;" data-sv="${s.nxt || ''}">${(() => {
                                const nxt = s.nxt || '';
                                if (nxt === 'N선') return '<span class="nxt-badge">N</span><span class="sun-badge">선</span>';
                                if (nxt === 'N')  return '<span class="nxt-badge">N</span>';
                                if (nxt === '선') return '<span class="sun-badge">선</span>';
                                return '';
                            })()}</td>
                            ${showKrMeta ? `<td style="text-align:center;" data-sv="${candle}">${candleHtml}</td><td style="text-align:center;" data-sv="${tag}">${tagHtml}</td>` : ''}
                        </tr>
                    `;
                });
            }

            html += `</tbody></table>`;

            html += `</div>`;   // ← 한국 컬럼 끝

            // [4] 상세 분석 — 한+미 계좌는 왼쪽 컬럼 안(한국표 바로 아래)에 붙인다
            if (hasUS) {
                html += `<div id="anal-area"></div>`;
                html += `</div>`;   // ← ga-left 끝
                html += `<div class="ga-right">`;
            }

            // [3] 미국 보유 종목 + 미국 요약 (데이터가 있는 계좌만)
            if (hasUS) {
                html += `<div class="ga-ussum">`;
                html += `<div class="col-cap">🇺🇸 미국</div>`;

                // [1] 미국/통합 요약 카드 (테이블 위)
                if (usSumm) {
                    const usStockKrw = usSumm.us_stock_krw || 0;
                    const usdCash = usSumm.usd_cash;
                    const usdCashKrw = usSumm.usd_cash_krw;
                    const rate = usSumm.rate;
                    const totalAll = computeAssetParts(summ, usSumm, hasUS).total;
                    const evalPlUsd = usSumm.eval_pl_usd;
                    const evalPlKrw = usSumm.eval_pl_krw;
                    const usRealizedUsd = usSumm.tdy_realized_pl_usd;
                    const usRealizedKrw = usSumm.tdy_realized_pl_krw;
                    const evalPlCls = (evalPlUsd == null) ? '' : (evalPlUsd >= 0 ? 'pos' : 'neg');
                    const usRealCls = (usRealizedUsd == null) ? '' : (usRealizedUsd >= 0 ? 'pos' : 'neg');
                    html += `
                        <div class="summary-card">
                            <h3 style="margin: 0 0 15px 0; font-size:1.1rem;">💵 미국 요약 (${acc})</h3>
                            <div class="summary-row">
                                <span class="label">미국주식 평가</span>
                                <span class="val">${fmt(usStockKrw)}원</span>
                            </div>
                            <div class="summary-row">
                                <span class="label">평가손익</span>
                                <span class="val ${evalPlCls}">${evalPlUsd == null ? '-' : (evalPlUsd >= 0 ? '+' : '') + '$' + evalPlUsd.toLocaleString(undefined, {maximumFractionDigits:2})}${evalPlKrw != null ? ` (${evalPlKrw >= 0 ? '+' : ''}${fmt(evalPlKrw)}원)` : ''}</span>
                            </div>
                            <div class="summary-row">
                                <span class="label">당일 실현손익</span>
                                <span class="val ${usRealCls}">${usRealizedUsd == null ? '-' : (usRealizedUsd >= 0 ? '+' : '') + '$' + usRealizedUsd.toLocaleString(undefined, {maximumFractionDigits:2})}${usRealizedKrw != null ? ` (${usRealizedKrw >= 0 ? '+' : ''}${fmt(usRealizedKrw)}원)` : ''}</span>
                            </div>
                            <div class="summary-row">
                                <span class="label">달러 예수금</span>
                                <span class="val">${usdCash !== null && usdCash !== undefined ? '$' + usdCash.toLocaleString() : '-'}${usdCashKrw ? ` (${fmt(usdCashKrw)}원)` : ''}</span>
                            </div>
                            <div class="summary-row">
                                <span class="label">적용환율</span>
                                <span class="val">${rate ? rate.toLocaleString() : '-'}</span>
                            </div>
                            <div class="summary-row">
                                <span class="label">총자산 (전통화)</span>
                                <span class="val" style="color:#2c3e50">${totalAll ? fmt(totalAll) + '원' : '-'}</span>
                            </div>
                            <div class="summary-row">
                                <span class="label">보유종목수</span>
                                <span class="val" style="color:#2c3e50">${fmt(usStocks.length)}개</span>
                            </div>
                        </div>
                    `;
                }

                html += `</div>`;  // ← ga-ussum 끝
                html += `<div class="ga-ustab">`;

                // [2] 미국 보유 종목 테이블
                html += `
                    <table class="us-table" id="tbl-us">
                        <thead>
                            <tr>
                                <th>티커</th>
                                <th>종목명</th>
                                <th style="text-align:right;">주수</th>
                                <th style="text-align:right;">현재가</th>
                                <th style="text-align:right;">매수가</th>
                                <th style="text-align:center;">매수날짜</th>
                                <th style="text-align:right;">수익률</th>
                                <th style="text-align:right;">평가금액</th>

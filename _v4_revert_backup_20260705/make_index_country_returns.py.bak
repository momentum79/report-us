# ── 저점 신호 5일 추적 ────────────────────────────────────
def load_low_history() -> dict:
    if not LOW_HISTORY_FILE.exists():
        return {}
    try:
        return json.loads(LOW_HISTORY_FILE.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"[경고] 저점 이력 읽기 실패: {e}")
        return {}


def update_low_history(low_signals_dict: dict) -> dict:
    """
    저점 신호 이력 업데이트
    - 7일 초과 항목 삭제, 새 신호 감지시 리셋
    """
    today     = date.today()
    today_str = today.isoformat()
    history   = load_low_history()

    to_delete = []
    for ticker, rec in history.items():
        try:
            first_date   = date.fromisoformat(rec["first_date"])
            if (today - first_date).days > 7:
                to_delete.append(ticker)
        except Exception:
            to_delete.append(ticker)
    for t in to_delete:
        del history[t]

    for ticker, (jeo, jeo2) in low_signals_dict.items():
        new_jeo  = (str(jeo).strip()  not in ("", "-", "0", "nan"))
        new_jeo2 = (str(jeo2).strip() not in ("", "-", "0", "nan"))
        if new_jeo or new_jeo2:
            if ticker in history:
                old_jeo  = history[ticker].get("signal_jeo",  False)
                old_jeo2 = history[ticker].get("signal_jeo2", False)
                if new_jeo != old_jeo or new_jeo2 != old_jeo2:
                    history[ticker] = {"first_date": today_str, "signal_jeo": new_jeo, "signal_jeo2": new_jeo2}
            else:
                history[ticker] = {"first_date": today_str, "signal_jeo": new_jeo, "signal_jeo2": new_jeo2}

    LOW_HISTORY_FILE.write_text(json.dumps(history, ensure_ascii=False, indent=2), encoding="utf-8")
    return history


def get_low_badge(ticker: str, history: dict) -> str:
    """
    이력 기반 저점 뱃지
    Day 0: 컴러 뱃지, Day1~5: 회색, Day6+: 빈 문자열
    """
    if ticker not in history:
        return ""
    rec = history[ticker]
    try:
        days_elapsed = (date.today() - date.fromisoformat(rec["first_date"])).days
    except Exception:
        return ""
    if days_elapsed == 0:
        if rec.get("signal_jeo") and rec.get("signal_jeo2"):
            return '<span class="low-badge low-both">저1,2</span>'
        elif rec.get("signal_jeo"):
            return '<span class="low-badge low-jeo">저</span>'
        elif rec.get("signal_jeo2"):
            return '<span class="low-badge low-jeo2">저2</span>'
    elif 1 <= days_elapsed <= 5:
        return f'<span class="low-badge low-track">{days_elapsed}저</span>'
    return ""

def get_sheet_data():
    print(f"[{datetime.now().strftime('%H:%M:%S')}] 구글 시트 데이터 로드 중...")
    try:
        # 메인 데이터 로드
        df_main = pd.read_excel(XLSX_URL_MAIN, sheet_name="국가별등락", header=None)
        cols_main = [1, 2, 22, 23, 24, 25, 26, 27]
        final_main = df_main.iloc[1:24, cols_main].dropna(subset=[2])
        
        # 요약 데이터 로드
        df_summ = pd.read_excel(XLSX_URL_SUMM, sheet_name="country", header=None)
        summ_data = df_summ.iloc[2:8, [12, 13, 14, 16, 17]].values.tolist()
        
        return final_main, summ_data
    except Exception as e:
        print(f"데이터 로드 실패: {e}")
        return None, None

def get_sco_track_data():
    TRACK_JSON = r"D:\py\report-us\world_sco_track.json"
    try:
        if os.path.exists(TRACK_JSON):
            import json
            with open(TRACK_JSON, 'r', encoding='utf-8') as f:
                return json.load(f)
    except Exception as e:
        print(f"World SCO Track 데이터 로드 실패: {e}")
    return {}

def get_world_rank_data():
    try:
        if os.path.exists(WORLD_RANK_JSON):
            with open(WORLD_RANK_JSON, 'r', encoding='utf-8') as f:
                return json.load(f)
    except Exception as e:
        print(f"World Rank JSON 데이터 로드 실패: {e}")
    return None

def generate_html(df, summ_data, world_rank, sco_track, low_history=None):
    if low_history is None:
        low_history = {}
    _now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    # 요약 테이블 생성
    summary_html = ""
    if summ_data:
        summary_html = '<div class="summary-container"><table class="summary-table">'
        for r_idx, row in enumerate(summ_data):
            summary_html += "<tr>"
            for c_idx, val in enumerate(row):
                v = str(val) if pd.notna(val) else ""
                style = ""
                display_val = v
                if r_idx == 0:
                    if c_idx == 2:
                        try: display_val = str(int(float(v)))
                        except: pass
                    style = 'class="summary-header"'
                else:
                    if c_idx in [2, 4]:
                        try:
                            fval = float(v.replace('%', '')) if '%' in v else float(v)
                            if -1 <= fval <= 1 and fval != 0: fval = fval * 100
                            prefix = "+" if fval > 0 else ""
                            display_val = f"{prefix}{fval:.2f}%"
                            if fval > 0: style = 'class="sig-up"'
                            elif fval < 0: style = 'class="sig-down"'
                        except: pass
                summary_html += f'<td {style}>{display_val}</td>'
            summary_html += "</tr>"
        summary_html += "</table></div>"

    # 지수추이 데이터 가공
    dates_list = sorted(sco_track.keys()) if sco_track else []
    spy_open_list  = [sco_track[d].get("spy_open")  for d in dates_list]
    spy_high_list  = [sco_track[d].get("spy_high")  for d in dates_list]
    spy_low_list   = [sco_track[d].get("spy_low")   for d in dates_list]
    spy_close_list = [sco_track[d].get("spy_close") for d in dates_list]
    spy_ma5_list   = [sco_track[d].get("spy_ma5") for d in dates_list]
    spy_ma10_list  = [sco_track[d].get("spy_ma10") for d in dates_list]
    spy_ma20_list  = [sco_track[d].get("spy_ma20") for d in dates_list]
    spy_ma60_list  = [sco_track[d].get("spy_ma60") for d in dates_list]
    spy_sco_list   = [sco_track[d].get("spy_sco") for d in dates_list]
    
    ewy_open_list  = [sco_track[d].get("ewy_open")  for d in dates_list]
    ewy_high_list  = [sco_track[d].get("ewy_high")  for d in dates_list]
    ewy_low_list   = [sco_track[d].get("ewy_low")   for d in dates_list]
    ewy_close_list = [sco_track[d].get("ewy_close") for d in dates_list]
    ewy_ma5_list   = [sco_track[d].get("ewy_ma5") for d in dates_list]
    ewy_ma10_list  = [sco_track[d].get("ewy_ma10") for d in dates_list]
    ewy_ma20_list  = [sco_track[d].get("ewy_ma20") for d in dates_list]
    ewy_ma60_list  = [sco_track[d].get("ewy_ma60") for d in dates_list]
    ewy_sco_list   = [sco_track[d].get("ewy_sco") for d in dates_list]
    
    avg_sco_list   = [sco_track[d].get("avg_sco") for d in dates_list]
    avg_final_sco_list = [sco_track[d].get("avg_final_sco") for d in dates_list]
    
    last_update = dates_list[-1] if dates_list else "-"
    last_spy_sco = spy_sco_list[-1] if spy_sco_list and spy_sco_list[-1] is not None else "-"
    last_ewy_sco = ewy_sco_list[-1] if ewy_sco_list and ewy_sco_list[-1] is not None else "-"
    last_avg_sco = avg_sco_list[-1] if avg_sco_list and avg_sco_list[-1] is not None else "-"
    last_avg_final_sco = avg_final_sco_list[-1] if avg_final_sco_list and avg_final_sco_list[-1] is not None else "-"

    import json, math
    # NaN/inf → null 로 정리 (Chart.js 캔들 자동스케일이 NaN 만나면 차트 전체가 안 그려짐)
    def _jdump(lst):
        cleaned = [None if (isinstance(x, float) and not math.isfinite(x)) else x for x in lst]
        return json.dumps(cleaned)
    json_dates = json.dumps(dates_list)
    json_spy_open  = _jdump(spy_open_list)
    json_spy_high  = _jdump(spy_high_list)
    json_spy_low   = _jdump(spy_low_list)
    json_spy_close = _jdump(spy_close_list)
    json_spy_ma5   = _jdump(spy_ma5_list)
    json_spy_ma10  = _jdump(spy_ma10_list)
    json_spy_ma20  = _jdump(spy_ma20_list)
    json_spy_ma60  = _jdump(spy_ma60_list)
    json_spy_sco   = _jdump(spy_sco_list)

    json_ewy_open  = _jdump(ewy_open_list)
    json_ewy_high  = _jdump(ewy_high_list)
    json_ewy_low   = _jdump(ewy_low_list)
    json_ewy_close = _jdump(ewy_close_list)
    json_ewy_ma5   = _jdump(ewy_ma5_list)
    json_ewy_ma10  = _jdump(ewy_ma10_list)
    json_ewy_ma20  = _jdump(ewy_ma20_list)
    json_ewy_ma60  = _jdump(ewy_ma60_list)
    json_ewy_sco   = _jdump(ewy_sco_list)

    json_avg_sco = _jdump(avg_sco_list)
    json_avg_final_sco = _jdump(avg_final_sco_list)

    # 국가별 랭킹 행 생성
    world_rank_rows = ""
    if world_rank and 'data' in world_rank:
        for item in world_rank['data']:
            ticker = item['Ticker']
            change_val = item.get('Change', '-').replace('%', '')
            change_class = ""
            try:
                f_chg = float(change_val)
                if f_chg > 0: change_class = "sig-up"
                elif f_chg < 0: change_class = "sig-down"
            except: pass

            # Color classes for Trend
            trend_class = ""
            trend_text = item.get('추세', '-')
            if trend_text in ['LIME', '3']: trend_class = "trend-lime"
            elif trend_text in ['GREEN', '2']: trend_class = "trend-green"
            elif trend_text == '1': trend_class = "trend-green-light"
            elif trend_text in ['RED', '-3']: trend_class = "trend-red"
            elif trend_text in ['PURPLE', '-2']: trend_class = "trend-purple"
            elif trend_text == '-1': trend_class = "trend-red-light"

            # Position classes
            pos_text = str(item.get('위치', '-'))
            pos_class = ""
            if pos_text == "5": pos_class = "pos-5"
            elif pos_text == "4": pos_class = "pos-4"

            # Jung/Yeok classes
            jung_text = item.get('정', '-')
            jung_class = ""
            if "정배" in jung_text: jung_class = "sig-jung"
            elif "역배" in jung_text: jung_class = "sig-yeok"

            # AVG 136 color
            avg_text = item.get('평균136', '-')
            avg_class = ""
            try:
                avg_val = float(avg_text.replace('%', ''))
                if avg_val > 0: avg_class = "sig-up"
                elif avg_val < 0: avg_class = "sig-down"
            except: pass

            # MA Direction symbols
            def get_ma_cls(v):
                if v == '상': return "up"
                if v == '하': return "down"
                return ""

            # Name 컬럼 배경색 (추세값 기반)
            name_style = ""
            if trend_class == 'trend-lime':        name_style = 'background-color:#2ecc71; color:#fff; font-weight:bold;'
            elif trend_class == 'trend-green':     name_style = 'background-color:#27ae60; color:#fff; font-weight:bold;'
            elif trend_class == 'trend-green-light': name_style = 'background-color:#a5d6a7; color:#1b5e20; font-weight:bold;'
            elif trend_class == 'trend-red':       name_style = 'background-color:#e74c3c; color:#fff; font-weight:bold;'
            elif trend_class == 'trend-red-light': name_style = 'background-color:#ef9a9a; color:#b71c1c; font-weight:bold;'
            elif trend_class == 'trend-purple':    name_style = 'background-color:#9b59b6; color:#fff; font-weight:bold;'

            world_rank_rows += f"""
                <tr>
                    <td class="col-ticker chart-trigger" data-ticker="{ticker}" style="cursor:pointer;">{ticker}</td>
                    <td class="col-name" style="{name_style}">{item['Name']}</td>
                    <td class="col-chg {change_class}">{item.get('Change', '-')}</td>
                    <td class="col-pos {pos_class}">{pos_text}</td>
                    <td class="col-sco">{item['sco']}</td>
                    <td class="col-jung {jung_class}">{jung_text}</td>
                    <td class="col-ma {get_ma_cls(item.get('M5', '-'))}">{item.get('M5', '-')}</td>
                    <td class="col-ma {get_ma_cls(item.get('M10', '-'))}">{item.get('M10', '-')}</td>
                    <td class="col-ma {get_ma_cls(item.get('M20', '-'))}">{item.get('M20', '-')}</td>
                    <td class="col-ma {get_ma_cls(item.get('M60', '-'))}">{item.get('M60', '-')}</td>
                    <td class="col-ma {get_ma_cls(item.get('M120', '-'))}">{item.get('M120', '-')}</td>
                    <td class="col-avg {avg_class}">{avg_text}</td>
                    <td class="col-return3m">{item['Return3M']}</td>
                    <td class="col-score"><strong>{item['Score']}</strong></td>
                    <td class="col-low">{get_low_badge(ticker, low_history)}</td>
                </tr>
            """

    # 구글 시트 데이터 행 생성
    google_sheet_rows = ""
    if df is not None:
        data = df.iloc[1:].values
        for row in data:
            google_sheet_rows += "<tr>"
            for i, val in enumerate(row):
                cls = ""
                display_val = ""
                if i == 0:
                    cls = "col-id"
                    display_val = str(val) if pd.notna(val) else "0"
                elif i == 1:
                    cls = "country-name"
                    display_val = str(val) if pd.notna(val) else ""
                else:
                    try:
                        num_val = float(val) if pd.notna(val) else 0.0
                        perc_val = num_val
                        if -1 < perc_val < 1 and perc_val != 0: perc_val = perc_val * 100
                        display_val = f"{perc_val:.2f}%"
                        if perc_val >= 10: cls = "ret-vhigh"
                        elif perc_val >= 5: cls = "ret-high"
                        elif perc_val >= 0: cls = "ret-mid"
                        elif perc_val >= -5: cls = "ret-low"
                        elif perc_val >= -10: cls = "ret-vlow"
                        else: cls = "ret-crash"
                    except: display_val = str(val) if pd.notna(val) else ""
                google_sheet_rows += f'<td class="{cls}">{display_val}</td>'
            google_sheet_rows += "</tr>"

    html_content = f"""

        /* [2] 상단 메뉴 (모바일/PC 공용) */
        .top-nav {
            display: flex;
            background-color: #2c3e50;
            position: sticky;
            top: 0;
            z-index: 9999;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            width: fit-content;
            margin: 0;
            border-radius: 0 0 8px 0;
        }

        .nav-item {
            padding: 10px 25px;
            /* 패딩 조정 */
            color: #bdc3c7;
            text-align: center;
            cursor: pointer;
            font-weight: bold;
            font-size: 1rem;
            border-bottom: 3px solid transparent;
        }

        .nav-item.active {
            color: #fff;
            background-color: #34495e;
            border-bottom-color: #3498db;
        }

        /* [3] 본문 컨텐츠 */
        .container {
            padding: 10px;
            max-width: 500px;
            /* PC에서도 컴팩트하게 */

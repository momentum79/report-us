  const rsiArr=rsiWilder(closes,14), rsiMa=smaArr(rsiArr,14);
  const rd =rows.map((b,i)=>rsiArr[i]==null?{time:b[0]}:{time:b[0],value:+rsiArr[i].toFixed(2)});

  const closes=rows.map(b=>b[4]);
  if(!stMode){
    MA_5.forEach(([p,color])=>{const m=new Map(sma(closes,p).map(o=>[rows[o.i][0],o.v]));
      const ln=ch.addLineSeries({color,lineWidth:1,priceLineVisible:false,priceFormat:priceFormat,

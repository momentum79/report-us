    const stUp=STS.map(r=>times.map((t,i)=>(r.st[i]!=null&&r.dir[i]<0)?{time:t,value:+r.st[i].toFixed(4)}:{time:t}));
    const stDn=STS.map(r=>times.map((t,i)=>(r.st[i]!=null&&r.dir[i]>0)?{time:t,value:+r.st[i].toFixed(4)}:{time:t}));

    <style>
        /* [1] 기본 스타일 - 절대 숨김(hidden) 처리 하지 않음 */
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f4f7f6;
            color: #333;

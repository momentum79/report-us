    </div>

    <script>
        // 안전한 숫자 포맷 함수
        function fmt(n) { return (n || 0).toLocaleString(); }

        // 매수일로부터 지난 영업일수(토·일만 제외). TR 모니터가 찍는 D+n 과 같은 규칙이라
        // 0001_us_monitor_1887.bat 콘솔의 D+8 과 게시판 D+8 이 같은 값이 된다.
        // 휴장일은 반영하지 않는다(장부 holding_business_days 와 동일한 근사).
        function dPlusDays(buyDate) {
            if (!buyDate) return null;
            const parts = String(buyDate).slice(0, 10).split('-');
            if (parts.length !== 3) return null;
            const cur = new Date(+parts[0], +parts[1] - 1, +parts[2]);
            if (isNaN(cur.getTime())) return null;
            const now = new Date();
            const end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            let n = 0;
            while (cur < end) {
                cur.setDate(cur.getDate() + 1);
                const d = cur.getDay();
                if (d !== 0 && d !== 6) n++;
            }
            return n;
        }

        // 제목 클릭 정렬. 값은 각 td 의 data-sv 를 먼저 보고, 없으면 표시 텍스트로 판단한다.
        // 빈 값은 오름/내림 상관없이 항상 뒤로 보낸다(공란이 위를 덮지 않게).
        function makeSortable(table) {
            if (!table || table._sortBound) return;
            table._sortBound = true;
            table.classList.add('sortable');
            Array.from(table.tHead ? table.tHead.rows[0].cells : []).forEach((th, idx) => {
                th.addEventListener('click', () => sortTableByCol(table, idx));
            });
        }

        function sortTableByCol(table, idx) {
            const tbody = table.tBodies[0];
            if (!tbody) return;
            const rows = Array.from(tbody.rows).filter(r => r.cells.length > idx && !r.cells[0].hasAttribute('colspan'));
            if (rows.length < 2) return;

            const st = table._sortState || {};
            const asc = (st.idx === idx) ? !st.asc : true;
            table._sortState = { idx: idx, asc: asc };

            const cellVal = (r) => {
                const c = r.cells[idx];
                if (!c) return '';
                const sv = c.getAttribute('data-sv');
                const raw = (sv !== null) ? sv : c.textContent.trim();
                if (raw === '' || raw === '-') return '';
                const num = parseFloat(String(raw).replace(/[^0-9.eE+-]/g, ''));
                return (!isNaN(num) && /[0-9]/.test(raw)) ? num : String(raw);
            };

            rows.sort((a, b) => {
                const x = cellVal(a), y = cellVal(b);
                if (x === '' && y === '') return 0;
                if (x === '') return 1;      // 공란은 항상 아래
                if (y === '') return -1;
                if (typeof x === 'number' && typeof y === 'number') return asc ? x - y : y - x;
                return asc ? String(x).localeCompare(String(y), 'ko') : String(y).localeCompare(String(x), 'ko');
            });
            rows.forEach(r => tbody.appendChild(r));
        }

        // ETF 브랜드 prefix 제거 + 6글자로 잘라 표시명 생성
        const ETF_PREFIXES = ['KODEX ', 'TIGER ', 'PLUS ', 'KINDEX ', 'ARIRANG ', 'HANARO ', 'ACE ', 'SOL ', 'KB스타 ', 'KIWOON ', 'TIME ', 'RISE ', 'KB STAR ', 'KBSTAR ', '키움 '];
        function getShortName(rawName) {
            if (!rawName) return '';
            const matched = ETF_PREFIXES.find(p => rawName.startsWith(p));
            const body = matched ? rawName.substring(matched.length) : rawName;
            return body.substring(0, 6);
        }

        // ───────── 주간성과 (봇 스타일별 주간 비교) ─────────
        function wpCell(v, suffix, colorPnl) {
            if (v === null || v === undefined || v === '') return '<td style="text-align:right;color:#bbb;">-</td>';
            let cls = '';
            if (colorPnl) cls = (Number(v) >= 0) ? 'wp-pos' : 'wp-neg';
            const txt = (typeof v === 'number') ? v.toLocaleString() : v;
            return `<td style="text-align:right;" class="${cls}">${txt}${suffix || ''}</td>`;
        }

        // 최대손실 셀: 값은 절대값(양수)으로 들어와서 손실임을 알기 어려움 → 표시만 "-" 접두
        function wpCellLoss(v) {
            if (v === null || v === undefined || v === '') return '<td style="text-align:right;color:#bbb;">-</td>';
            const n = Number(v);
            const txt = (n > 0) ? `-${n}` : `${n}`;
            return `<td style="text-align:right;">${txt}%</td>`;
        }

        // 손익비 셀: 기준점 1.0 대비 이상=녹색 / 미만=빨강
        function wpRatio(v) {
            if (v === null || v === undefined || v === '') return '<td style="text-align:center;color:#bbb;">-</td>';
            const cls = (Number(v) >= 1) ? 'wp-good' : 'wp-bad';
            return `<td style="text-align:center;" class="${cls}">${Number(v).toFixed(2)}</td>`;
        }

        // 봇별 실행 계좌(뒤4자리). 통합/금주성과 미니표에는 미표기.
        const BOT_ACCT = {'주도주':'1887','ROCKET':'1887','2X단타':'8042','삼닉v3_저2':'8042','삼닉v3_추세':'8042','삼닉v3_MA':'8042',
                          '5minHL':'2773','5minHL2':'2773','5minHL_동시':'2773','5minHL_미분류':'2773','기타(8042)':'8042','저점사다리':'1887',
                          '통합ETF':'8042','ABC-VCP':'1887','수동매매':'1887','미국VCP':'1887(US)','미국수동':'1887(US)',
                          'KR_TR_ORD_B':'2773','KR_TR_ORD_1A0':'2773','KR_TR_VOLUME_1':'2773','KR_TR_VOLUME_2':'2773','KR_TR_VCP1':'2773','KR_TR_VCP2':'2773',
                          'KR_TR_JEO2':'2773','KR_TR_MA':'2773','US_TR_ORD_B':'1887(US)','US_TR_ORD_1A0':'1887(US)','US_TR_VOLUME_1':'1887(US)',
                          'US_TR_VOLUME_2':'1887(US)','US_TR_VCP1':'1887(US)','US_TR_VCP2':'1887(US)','US_TR_JEO2':'1887(US)','US_TR_MA':'1887(US)',
                          '업비트SCO-Top3':'업비트','업비트SCO-15분':'업비트','바이낸스SCO-Top3':'바이낸스 선물(USDT→원)'};
        // 코인 TR 은 장부 태그가 그대로 행 이름이라(UP_TR_*/BN_TR_*) 접두사로 계좌를 붙인다.
        const botAcct = k => BOT_ACCT[k] || (String(k).startsWith('UP_TR_') ? '업비트'
                             : (String(k).startsWith('BN_TR_') ? '바이낸스 선물(USDT→원)' : ''));

        // 그룹 라벨. bot=자동매매 / alloc=자산배분 / manual=사람이 직접 매수 / seed=컷오프 시딩분
        const WP_AGG = new Set(['통합', '수동합계']);   // 합산 행(개별 태그 아님) — 중복합산 방지
        const WP_SEED_SUFFIX = '_시딩';
        const isSeedKey = k => String(k).endsWith(WP_SEED_SUFFIX);
        const baseKey = k => isSeedKey(k) ? String(k).slice(0, -WP_SEED_SUFFIX.length) : k;
        const WP_GROUP_NOTE = {
            '통합': '봇 태그만 합산 · 수동/자산배분/시딩 제외',
            '수동합계': '참고용 · 통합에 미포함',
            '통합ETF': '자산배분 리밸런싱 · 통합에 미포함',
        };
        // 시딩 카드 부제: 진입가가 실제 매수가가 아니라 컷오프 직전 종가다.
        const wpGroupNote = key => isSeedKey(key)
            ? `컷오프 시딩분 청산 · 진입가=컷오프 직전 종가 → 봇 성과 아님 · 통합에 미포함`
            : (WP_GROUP_NOTE[key] || '');

        function renderWeeklyBot(bot, extraCls) {
            const unit = bot.unit;              // '일' | '분' | '혼합'
            const isMix = (unit === '혼합');
            const collapsible = bot.key !== '통합';
            const cardId = `wp-card-${String(bot.key).replace(/[^a-zA-Z0-9가-힣_-]/g, '_')}`;
            const holdHdr = isMix ? '' :
                `<th>수익<br>보유(${unit})</th><th>손실<br>보유(${unit})</th>`;
            let rows = '';
            const mkRow = (s, isTotal, rowIndex) => {
                const trCls = isTotal ? 'wp-total' : ((collapsible && rowIndex >= 2) ? 'wp-extra-week' : '');
                // 보유'분'은 소수점이 의미 없어 정수 반올림(열 폭도 절약). '일'은 소수 유지.
                const rnd = v => (unit === '분' && typeof v === 'number') ? Math.round(v) : v;
                const hold = isMix ? '' :
                    wpCell(rnd(s.hold_win), '') + wpCell(rnd(s.hold_loss), '');
                const pnlColor = (s.sum_pnl_amt >= 0) ? 'wp-pos' : 'wp-neg';
                return `<tr class="${trCls}">
                    <td>${s.label}</td>
                    <td style="text-align:center;">${s.trades}</td>
                    ${wpCell(s.winrate, '%')}
                    ${wpRatio(s.pl_ratio)}
                    ${wpCell(s.expectancy, '%')}
                    ${wpRatio(s.profit_factor)}
                    ${wpCell(s.avg_win, '%')}
                    ${wpCell(s.avg_loss, '%')}
                    ${wpCell(s.max_win, '%')}
                    ${wpCellLoss(s.max_loss)}
                    ${hold}
                    <td style="text-align:right;" class="${pnlColor}">${(s.sum_pnl_amt>=0?'+':'')}${(s.sum_pnl_amt||0).toLocaleString()}</td>
                </tr>`;
            };
            [...bot.weeks].reverse().forEach((w, i) => { rows += mkRow(w, false, i); });
            rows += mkRow(bot.total, true, 999);
            const toggle = collapsible
                ? `<button class="wp-fold-btn" type="button" onclick="toggleWeeklyCard('${cardId}', this)" title="최근 2주만 보기/전체 보기">+</button>`
                : '';
            const noteTxt = wpGroupNote(bot.key);
            const note = noteTxt ? ' · ' + noteTxt : '';
            return `<div id="${cardId}" class="wp-card${collapsible ? ' wp-collapsed' : ''}${extraCls ? ' ' + extraCls : ''}">
                <div class="wp-title">${toggle}${bot.key} <span class="wp-unit">보유단위: ${unit}${(botAcct(baseKey(bot.key)) ? ', ' + botAcct(baseKey(bot.key)) : '')}${note}</span></div>
                <div class="wp-tablewrap"><table class="wp-table">
                    <thead><tr>
                        <th>주(월~금)</th><th>거래</th><th>승률</th><th>손익비</th>
                        <th title="1거래당 기대수익(수수료·세금 차감 후)">기대값</th>
                        <th title="총이익/총손실. 1.0=본전, 1.5+=견고">PF</th>
                        <th>평균수익</th><th>평균손실</th><th>최대수익</th><th>최대손실</th>
                        ${holdHdr}<th title="수수료·증권거래세 차감 후">실현손익</th>
                    </tr></thead>
                    <tbody>${rows}</tbody>
                </table></div>
            </div>`;
        }

        // 잔고 드리프트 경고 배너.
        // '트래커+TR장부' 미청산 vs 실제 계좌잔고가 어긋나면 이 표 전체가 조용히 틀어진다.
        // 특히 트래커엔 있는데 계좌엔 0주인 '유령'은 라운드트립이 영영 안 닫혀서
        // 그 태그 성과가 통째로 안 잡힌다(미국VCP 가 계속 0건이던 이유).
        // 지금까지 콘솔 로그에만 찍혀서 아무도 못 봤다 → 표 맨 위로 끌어올린다.
        function renderDriftBanner(data) {
            const d = data.drift;
            if (!d || !d.count) return '';
            const rows = (d.rows || []).map(r => `<tr${r.ghost ? ' class="wp-drift-ghost"' : ''}>
                    <td>${r.acct}</td><td>${r.code}</td>
                    <td style="text-align:right;">${r.tracked.toLocaleString()}</td>
                    <td style="text-align:right;">${r.actual.toLocaleString()}</td>
                    <td style="text-align:right;">${r.diff > 0 ? '+' : ''}${r.diff.toLocaleString()}</td>
                    <td style="text-align:center;">${r.ghost ? '유령' : ''}</td>
                </tr>`).join('');
            const more = d.more ? `<tr><td colspan="6" style="color:#999;">… 외 ${d.more}건</td></tr>` : '';
            return `<div class="wp-drift">
                <div class="wp-drift-head">
                    ⚠ 잔고 드리프트 <b>${d.count}건</b>${d.ghost ? ` (그중 <b>유령 ${d.ghost}건</b> — 트래커엔 있는데 계좌엔 0주)` : ''}
                    <span class="wp-drift-when">확인 ${d.checked_at || '-'}${d.cutoff ? ` · 컷오프 ${d.cutoff}` : ''}</span>
                    <button class="wp-fold-btn wp-drift-btn" type="button"
                            onclick="const t=document.getElementById('wp-drift-tbl');t.hidden=!t.hidden;this.textContent=t.hidden?'+':'−';">+</button>
                </div>
                <div class="wp-drift-msg">유령은 라운드트립이 영영 안 닫혀 <b>그 태그 성과가 아예 안 잡힌다</b>.
                    크게 벌어졌으면 <code>${d.fix_hint || 'python 0order/make_position_baseline.py --apply'}</code> 로 컷오프 재설정.</div>
                <div id="wp-drift-tbl" hidden><table class="wp-table" style="margin-top:6px;">
                    <thead><tr><th>계좌</th><th>종목</th><th>트래커</th><th>실제</th><th>차이</th><th>비고</th></tr></thead>
                    <tbody>${rows}${more}</tbody>
                </table></div>
            </div>`;
        }

        // 코인(업비트) 이번 주(월~일) BTC/ETH 실현손익 미니표 (3열)
        function renderCoinWeek(data) {
            const cw = data.coin_week;
            if (!cw) return '';
            const cell = v => {
                if (v === null || v === undefined) return '<td style="text-align:right;color:#bbb;">-</td>';
                const cls = v >= 0 ? 'wp-pos' : 'wp-neg';
                return `<td style="text-align:right;" class="${cls}">${(v>=0?'+':'')}${v.toLocaleString()}원</td>`;
            };
            let body = '';
            (cw.days || []).forEach(d => {
                body += `<tr><td style="text-align:left;">${d.label}</td>${cell(d.btc)}${cell(d.eth)}</tr>`;
            });
            const total = cw.total || 0;
            const totalCls = total >= 0 ? 'wp-pos' : 'wp-neg';
            const totalTxt = `${(total>=0?'+':'')}${total.toLocaleString()}원`;
            return `<div class="wp-summary">
                <table class="wp-mini wp-coin">
                    <thead>
                        <tr><th style="text-align:left;">코인 성과</th><th style="text-align:right;" colspan="2"><span class="${totalCls}">${totalTxt}</span></th></tr>
                        <tr><th style="text-align:left;">요일</th><th style="text-align:right;">BTC</th><th style="text-align:right;">ETH</th></tr>
                    </thead>
                    <tbody>${body}</tbody>
                </table>
            </div>`;
        }

        // 미국VCP 매수 포착 보드 (buy-only). 미국 ORDER A 는 매수만 기록 → 라운드트립 없음.
        // 실현손익 대신 주별 매수 종목·수량·단가(USD)·태그 포착만 표시.
        function renderUsVcpBoard(data) {
            const uv = data.us_vcp;
            if (!uv || !uv.has_data) return '';
            let rows = '';
            (uv.weeks || []).forEach(w => {
                (w.buys || []).forEach(b => {
                    rows += `<tr>
                        <td style="text-align:center;">${w.label}</td>
                        <td style="text-align:center;">${b.date.slice(5)}</td>
                        <td style="text-align:left;">${b.code}</td>
                        <td style="text-align:right;">${(b.qty||0).toLocaleString()}</td>
                        <td style="text-align:right;">$${Number(b.price||0).toFixed(2)}</td>
                        <td style="text-align:right;">$${Number(b.amount||0).toLocaleString(undefined,{maximumFractionDigits:0})}</td>
                    </tr>`;
                });
            });
            const tot = uv.total || {count:0, amount:0};
            rows += `<tr class="wp-total">
                <td colspan="3">합계 (최근 8주)</td>
                <td style="text-align:right;">${(tot.count||0).toLocaleString()}건</td>
                <td></td>
                <td style="text-align:right;">$${Number(tot.amount||0).toLocaleString(undefined,{maximumFractionDigits:0})}</td>
            </tr>`;
            return `<div class="wp-card">
                <div class="wp-title">미국VCP <span class="wp-unit">매수 포착 · 1887(US) · 매도로직 없음 → 실현손익은 매도 시</span></div>
                <div class="wp-tablewrap"><table class="wp-table">
                    <thead><tr>
                        <th>주(월~금)</th><th>매수일</th><th>종목</th><th>수량</th><th>매수가</th><th>매수금액</th>
                    </tr></thead>
                    <tbody>${rows}</tbody>
                </table></div>
            </div>`;
        }

        // 3개월(최대 13주) 태그별 누적표. "뭘 늘리고 뭘 죽일지" 판단용 — 이 게시판의 본목적.
        // 서버(make_weekly_performance.py build_quarter)가 이미 그룹·손익순으로 정렬해 보낸다.
        function renderQuarter(data) {
            const q = data.quarter;
            if (!q || !(q.rows || []).length) return '';
            const GRP = {bot: '봇', alloc: '자산배분', manual: '수동',
                         seed: '컷오프 시딩분 (봇 성과 아님)', legacy: '레거시 편입분'};
            let rows = '';
            let prevGrp = null;
            q.rows.forEach(r => {
                if (prevGrp !== null && r.group !== prevGrp) {
                    rows += `<tr class="wp-qsep"><td colspan="10">${GRP[r.group] || r.group}</td></tr>`;
                }
                prevGrp = r.group;
                const isAgg = WP_AGG.has(r.key);
                const cls = (isAgg ? 'wp-total ' : '') + (r.group === 'manual' ? 'wp-muted' : '');
                const amt = r.sum_pnl_amt || 0;
                rows += `<tr class="${cls}">
                    <td>${r.key}</td>
                    <td style="text-align:center;">${r.trades}</td>
                    <td style="text-align:center;color:#999;">${r.sell_events == null ? '-' : r.sell_events}</td>
                    ${wpCell(r.winrate, '%')}
                    ${wpRatio(r.pl_ratio)}
                    ${wpCell(r.expectancy, '%')}
                    ${wpRatio(r.profit_factor)}
                    <td style="text-align:right;">${(r.expectancy_amt == null) ? '-' : r.expectancy_amt.toLocaleString()}</td>
                    <td style="text-align:right;color:#999;">${(r.sum_fee_tax || 0).toLocaleString()}</td>
                    <td style="text-align:right;" class="${amt >= 0 ? 'wp-pos' : 'wp-neg'}">${(amt >= 0 ? '+' : '')}${amt.toLocaleString()}</td>
                </tr>`;
            });
            const scope = q.clamped_to_cutoff
                ? `${(q.clamp_from && q.clamp_from === data.display_from) ? '표시 시작일' : '컷오프'}(${q.clamp_from || data.cutoff_date}) 이후 ${q.weeks}주`
                : `최근 ${q.weeks}주`;
            return `<div class="wp-card wp-solo wp-quarter">
                <div class="wp-title">3개월 누적 (태그별) <span class="wp-unit">${q.label} · ${scope} · 봇 → 자산배분 → 수동 순, 그룹 안에서는 손익순</span></div>
                <div class="wp-tablewrap"><table class="wp-table">
                    <thead><tr>
                        <th>tag</th><th title="완결 포지션 수">거래</th>
                        <th title="부분매도 포함 매도 건수 (컷오프 이후만 집계)">매도</th>
                        <th>승률</th><th>손익비</th><th>기대값</th><th>PF</th>
                        <th title="1거래당 기대 손익(원)">기대값(원)</th>
                        <th>비용</th><th>실현손익</th>
                    </tr></thead>
                    <tbody>${rows}</tbody>
                </table></div>
            </div>`;
        }

        // 금주(최근 주) 봇별 실현손익 미니 요약표.
        // 데이터 기반: 이번주 거래가 있는 모든 봇(통합 제외)을 자동 나열.
        // 헤드라인 총계 = '통합'(전체 라운드트립 합) 금주 실현손익 → 통합ETF·수동매매·ABC-VCP 자동 포함.
        const WEEKLY_SPLIT_TAGS = new Set(['2X단타','삼닉v3_저2','삼닉v3_추세','삼닉v3_MA','저점사다리','미국수동','기타(8042)']);

        function renderWeeklySummary(data, opts = {}) {
            const weekKeys = data.week_keys || [];
            if (!weekKeys.length) return '';
            const latest = weekKeys[weekKeys.length - 1];
            const rename = {'2X단타':'2x단타','5min저고단타':'5min저고','ROCKET':'로켓'};
            const wkOf = (b) => (b.weeks || []).find(x => x.week === latest);
            let body = '';
            let total = 0;
            const grpSum = {bot: 0, alloc: 0, manual: 0};
            // 합산 행(통합/수동합계)은 개별 태그와 중복이라 제외한다.
            (data.bots || []).filter(b => !WP_AGG.has(b.key)).forEach(b => {
                const inSplit = WEEKLY_SPLIT_TAGS.has(b.key);
                if (opts.onlySplit && !inSplit) return;
                if (opts.excludeSplit && inSplit) return;
                const w = wkOf(b);
                const amt = (w && w.sum_pnl_amt) || 0;
                total += amt;
                grpSum[b.group] = (grpSum[b.group] || 0) + amt;
                const cls = amt >= 0 ? 'wp-pos' : 'wp-neg';
                const nm = rename[b.key] || b.key;
                const zeroCls = ((!w || !w.trades) ? ' wp-zero' : '') + (b.group === 'manual' ? ' wp-muted' : '');
                body += `<tr class="${zeroCls}"><td style="text-align:left;">${nm}</td>`
                     +  `<td style="text-align:center;">${(w && w.trades) || 0}</td>`
                     +  `<td style="text-align:right;" class="${cls}">${(amt>=0?'+':'')}${amt.toLocaleString()}원</td></tr>`;
            });
            // 그룹 소계: 헤더 총계가 봇 성과인 것처럼 읽히지 않도록 내역을 붙인다.
            if (!opts.onlySplit) {
                const money = v => `${(v>=0?'+':'')}${v.toLocaleString()}원`;
                [['bot','봇 합계'],['alloc','자산배분'],['manual','수동(참고)']].forEach(([g, lbl]) => {
                    const v = grpSum[g] || 0;
                    body += `<tr class="wp-grpsum"><td style="text-align:left;" colspan="2">${lbl}</td>`
                         +  `<td style="text-align:right;" class="${v>=0?'wp-pos':'wp-neg'}">${money(v)}</td></tr>`;
                });
            }
            const totalCls = total >= 0 ? 'wp-pos' : 'wp-neg';
            const totalTxt = `${(total>=0?'+':'')}${total.toLocaleString()}원`;
            const title = opts.title || '금주 성과';
            return `<div class="wp-summary">
